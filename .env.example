# Copy to .env for local runs (Windows: copy .env.example .env).
# On Streamlit Community Cloud put these in the app's Secrets instead (TOML: KEY = "value").
# Placeholders only: NEVER commit real keys.

# ---- Keys --------------------------------------------------------------------
# TEXT answers (required): free key, no credit card -> console.groq.com/keys
GROQ_API_KEY=
# IMAGES only (figure questions, scanned pages): free key -> openrouter.ai/settings/keys
# Without it the app still works; figure questions then use captions and nearby text.
OPENROUTER_API_KEY=

# free    | Groq for text, Gemma 4 ":free" for images -> $0
# quality | Groq for text, Qwen 3.8 (paid, cents) first for images
MODEL_PROFILE=free

# ---- Override model chains ("provider:model", comma separated, tried in order) ----
# e.g. MASTER_MODELS=groq:openai/gpt-oss-120b,groq:llama-3.3-70b-versatile
#      VISION_MODELS=openrouter:qwen/qwen3.8-flash,openrouter:google/gemma-4-31b-it:free
MASTER_MODELS=
FAST_MODELS=
VERIFIER_MODELS=
VISION_MODELS=
REASONING_EFFORT=low          # none | low | medium | high  (hidden reasoning of gpt-oss; never shown)
DATA_COLLECTION=allow         # OpenRouter: deny = only upstreams that don't store prompts (free endpoints may vanish)
APP_URL=https://github.com/your-name/rag-ultimate
APP_TITLE=RAG Ultimate

# ---- Images: when Qwen / Gemma are used -----------------------------------------
IMAGE_ANSWERS=true            # figure questions: attach the figure images (else captions only, via Groq)
MAX_ANSWER_IMAGES=2           # images per figure question
IMAGE_MAX_PX=1024             # images are downscaled first (fewer image tokens)
OCR_SCANNED=true              # read image-only (scanned) pages while indexing
MAX_OCR_PAGES=40
VISION_INDEX=false            # describe EVERY figure while indexing (many calls; off = only when asked)
MAX_VISION_FIGURES=40
VISION_WORKERS=4

# ---- Retrieval (local = 0 tokens) -------------------------------------------------
EMBED_BACKEND=local           # local | openrouter (Qwen3-Embedding) | auto
RERANK=true
RERANK_BACKEND=local          # local | openrouter (Qwen3-Reranker) | auto
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
EMBED_MODEL_REMOTE=qwen/qwen3-embedding-8b
RERANK_MODEL_REMOTE=qwen/qwen3-reranker-8b
EMBED_DIMS=1024

# ---- Answering (token budget) ----------------------------------------------------
AGENT_MODE=agent              # agent (tools only for calculations/comparisons) | quick (always one call)
AGENT_MAX_STEPS=3
VERIFY_WITH_LLM=false         # extra LLM check (Groq Llama 70B); deterministic checks always run for free
MAX_REGENERATIONS=1
MEMORY_TURNS=2
MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=90

# ---- Retrieval, chunking, uploads -------------------------------------------
TOP_K=3
CHUNK_SIZE=400
CHUNK_OVERLAP=60
MAX_CONTEXT_CHUNKS=6
MAX_CONTEXT_CHARS=5000        # ~1,250 tokens of evidence per answer
MAX_UPLOAD_MB=50
MAX_PAGES=500

# ---- Persistent storage (recommended on Streamlit Cloud) -------------------
# Private Hugging Face dataset that keeps chats, feedback, preferences and
# document indexes across restarts. The dataset is created (private) automatically.
HF_TOKEN=
HF_DATASET_REPO=            # e.g. your-hf-username/rag-ultimate-data  (or file:///path for a local disk)
SYNC_INTERVAL=45

# ---- Access and production guards ----------------------------------------------
APP_PASSWORD=               # if set, the whole app asks for this password
RATE_LIMIT_PER_MIN=8        # questions per browser session per minute (0 = off)
GLOBAL_RATE_LIMIT_PER_MIN=25 # Groq free tier: ~30 requests/min
DAILY_BUDGET_USD=0          # 0 = off; pauses AI answers once today's OpenRouter spend reaches this
ANSWER_CACHE_SIZE=256
ANSWER_CACHE_TTL=3600
HEALTH_WEIGHTS=0.30,0.20,0.20,0.20,0.10
LOG_LEVEL=INFO

# ---- Cross-modal concept linking -------------------------------------------
CONCEPT_LINKING=true
CONCEPT_EXPAND_MAX=4
CONCEPT_MIN_CONF=0.6
CONCEPT_LLM_RESOLVE=false
